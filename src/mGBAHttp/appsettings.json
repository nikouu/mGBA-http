{
  // The address mGBA-http itself listens on. Change the port here to serve the API somewhere else
  "Urls": "http://localhost:5000",
  "mgba-http": {
    "Console": {
      // Adds a correlation ID, status code and timing under each request line
      "Detailed": false
    },
    "Socket": {
      // How mGBA-http reaches mGBA
      "IpAddress": "127.0.0.1",
      // Port must match 'port' in Lua file
      "Port": 8888,
      // Milliseconds to wait for mGBA to accept a command and to reply
      "ReadTimeout": 3000,
      "WriteTimeout": 3000
    }
  },
  "AllowedHosts": "*"
}
